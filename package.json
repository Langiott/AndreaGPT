{
  "name": "andreagpt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --use-system-ca --import tsx --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-system-ca --import tsx server/index.ts",
    "start:prod": "node --use-system-ca --import tsx server/index.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts",
    "brain": "tsx server/brain-cli.ts",
    "smoke:local": "tsx scripts/Smoke-Locale.ts",
    "benchmark:router": "tsx scripts/Benchmark-Router.ts",
    "benchmark:retrieval": "tsx scripts/Benchmark-Retrieval.ts"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@vitejs/plugin-react": "latest",
    "adm-zip": "^0.6.1",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "fast-xml-parser": "^5.11.1",
    "katex": "^0.18.7",
    "lucide-react": "latest",
    "pdf-parse": "2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "latest",
    "remark-math": "^6.0.0",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "undici": "^8.10.2",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
