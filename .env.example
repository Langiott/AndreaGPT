# Ollama e Brain non richiedono chiavi. Cloud opzionale.
NVIDIA_API_KEY=nvapi-inserisci-la-tua-chiave
OPENROUTER_API_KEY=sk-or-inserisci-la-tua-chiave

# Opzionali
APP_PORT=3000
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
SEARXNG_URL=http://127.0.0.1:8080
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
# Docker imposta automaticamente host.docker.internal e i percorsi montati.
# BRAIN_ROOT=C:/percorso/ANDREA-BRAIN
# BRAIN_DATA_DIR=C:/percorso/data/brain
